load_module modules/ngx_http_js_module.so;

daemon off;
worker_processes auto;
error_log /dev/stderr warn;
pid /run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    js_import opml from /app/nginx-opml.js;
    js_set $cache_uri opml.cache_uri;

    charset utf-8;
    charset_types text/xml application/xml application/atom+xml text/x-opml;

    access_log /dev/stdout;

    sendfile on;
    tcp_nopush on;

    # ETag enabled by default

    server {
        listen 80;
        server_name _;

        # Use relative redirects (no host prefix)
        absolute_redirect off;

        # The browser shell is served for the root page. The shell fetches the
        # machine-readable OPML feed in the browser.
        location = / {
            root /app/static;
            try_files /index.html =404;
            add_header Cache-Control "no-cache";
            add_header Content-Security-Policy "default-src 'none'; script-src 'self' 'inline-speculation-rules'; style-src 'self'; img-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'";
        }

        # Static shell assets are private to the shell namespace.
        location = /_app/ {
            return 404;
        }

        location = /_app/index.html {
            return 404;
        }

        location /_app/ {
            alias /app/static/;
            add_header Cache-Control "no-cache";
            types {
                text/javascript js;
                text/css css;
                image/svg+xml svg;
                image/png png;
                image/x-icon ico;
                application/manifest+json webmanifest;
            }
        }

        location /static/ {
            return 404;
        }

        # Publication readiness from Bun lifecycle
        location = /ready {
            proxy_pass http://127.0.0.1:${BUN_PORT}/ready;
            proxy_set_header Host $host;
        }

        location = /events {
            return 404;
        }

        # Browser pages use a dedicated namespace so source-relative feeds and
        # audio files never compete with the shell URL.
        location = /browse {
            return 301 /browse/;
        }

        # Keep this as a plain prefix so regex feed and image locations keep
        # precedence; a source folder named browse keeps its feed.xml and cover.jpg.
        location /browse/ {
            root /app/static;
            try_files /index.html =404;
            add_header Cache-Control "no-cache";
            add_header Content-Security-Policy "default-src 'none'; script-src 'self' 'inline-speculation-rules'; style-src 'self'; img-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'";
        }

        # Admin endpoint: /resync (only if auth configured)
        # AUTH_BLOCK_START
        location = /resync {
            auth_basic "Podcast Admin";
            auth_basic_user_file /etc/nginx/.htpasswd;

            proxy_pass http://127.0.0.1:${BUN_PORT}/resync;
            proxy_method POST;
            proxy_set_header Host $host;
        }

        # AUTH_BLOCK_END

        # Audio file streaming — direct nginx static, no Content-Disposition (inline for podcast apps)
        location /audiobooks/ {
            alias /audiobooks/;
            sendfile on;
            sendfile_max_chunk 1m;
            tcp_nopush on;

            # Rate limit (0 = disabled)
            limit_rate ${RATE_LIMIT};
        }

        # Images - cache 1 day, then validate with ETag
        location ~ \.(jpg|jpeg|png|webp)$ {
            root /data;
            try_files $cache_uri =404;
            expires 1d;
            add_header Cache-Control "public, must-revalidate";
        }

        # OPML feed — njs replaces {{{BASE_URL}}} with request origin
        location = /feed.opml {
            root /data;
            types { text/xml opml; }
            js_header_filter opml.header_filter;
            js_body_filter opml.body_filter;
            add_header Cache-Control "no-cache";
            error_page 404 = @check_initializing;
        }

        # XML feeds - njs replaces {{{BASE_URL}}} with request origin
        location ~ \.xml$ {
            root /data;
            try_files $cache_uri $cache_uri/ =404;
            js_header_filter opml.header_filter;
            js_body_filter opml.body_filter;
            add_header Cache-Control "no-cache";
            error_page 404 = @check_initializing;
        }

        # Every other path is not a published endpoint.
        location / {
            return 404;
        }

        location @check_initializing {
            # If requesting feed.opml and it doesn't exist, return 503
            if ($uri ~* feed\.opml$) {
                return 503;
            }
            return 404;
        }

        # Custom error pages
        error_page 503 @initializing;
        location @initializing {
            default_type application/json;
            return 503 '{"status":"initializing","message":"Server is starting, please retry later"}';
            add_header Retry-After 5 always;
        }
    }
}
